from src.ingestion import load_documents, chunk_documents

def test_multiple_docs(tmp_path):
    (tmp_path/"doc1.txt").write_text("Insurance cover accidental damage.")

    (tmp_path/"doc2.txt").write_text("The deductible id INR 500.")

    documents= load_documents(tmp_path)

    assert len(documents) == 2
    assert documents[0]["metadata"]["source"] == "doc1.txt"

def test_chunk_documents_preserves_metadata():
    documents = [{"text":" ".join(f"word{i}" for i in range(100)),
                  "metadata": {"source": "policy.pdf",
                               "page": 2}}]


    chunks = chunk_documents(documents, chunk_size=20, overlap=5)

    assert len(chunks) > 1
    assert chunks[0]["metadata"]["source"] == "policy.pdf"
    assert chunks[0]["metadata"]["page"] == 2
    assert chunks[0]["chunk_id"] == "policy.pdf_p2_chunk_0"

def test_chunk_documents_rejects_invalid_overlap():
    documents = [{"text":"some text",
                  "metadata": {"source": "test.txt",
                               "page": None}}]

    try:
        chunk_documents(documents, chunk_size=10, overlap=10)
    except ValueError:
        pass
    else:
        assert False, "Expected ValueError"